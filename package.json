{
  "name": "wawuafrica-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "_comment:contract": "contract/openapi.json is a pinned copy of the backend's generated spec (wawu-backend: npm run contract:build). Refresh it with contract:sync, then regenerate. Never hand-edit either file.",
    "contract:sync": "cp ../wawu-backend/contract/openapi.json contract/openapi.json",
    "contract:types": "openapi-typescript contract/openapi.json -o src/types/api.generated.ts",
    "sync-agent-rules": "bash scripts/sync-agent-rules.sh",
    "check:copy": "node scripts/check-copy.mjs",
    "check:icons": "node scripts/build-icon-set.mjs --check",
    "build:icons": "node scripts/build-icon-set.mjs",
    "check:qr": "node scripts/check-qr.mjs",
    "check:tgif": "node scripts/check-tgif.mjs",
    "build:tgif": "node scripts/build-tgif.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "jsqr": "^1.4.0",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5"
  }
}
