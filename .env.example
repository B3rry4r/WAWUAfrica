# Frontend-only test run: leave NEXT_PUBLIC_API_BASE_URL empty to run entirely
# on local mock data (sign up, sign in, feed, unlock, search, notifications,
# purchases all work without a backend). Set it to a real origin when the
# backend exists; the app still falls back to mocks if a call fails.
NEXT_PUBLIC_API_BASE_URL=

# Force mock mode even when a base URL is set:
NEXT_PUBLIC_USE_MOCKS=false

# WAWU ID (external identity service) -- auth.ts calls this DIRECTLY, never
# the Hub API, per .pipeline/supersedes.json S-4. Defaults to
# http://localhost:3000 (WAWU ID's own local default) if unset. Point this
# at mock-wawu-id (WAWU-Hub-API/mock-wawu-id, typically :4001) for local
# dev/testing without real WAWU ID credentials.
NEXT_PUBLIC_WAWU_ID_BASE_URL=

# Flutterwave public key. Empty/absent means the unlock sheet simulates payment.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
# App links (LINKS-01, src/lib/app-links.ts). The two values below belong to the
# people who sign the WAWU app; they are read on every request by
# /.well-known/apple-app-site-association and /.well-known/assetlinks.json.
# Until one is set, its file names no app for that platform. Never commit a value.
# The 10-character Apple developer team id (iOS universal links):
APPLE_TEAM_ID=
# The app's signing certificate SHA-256 fingerprint, AA:BB:... (32 bytes). With
# Play App Signing list both the upload key's and the app signing key's,
# comma separated (Android app links):
ANDROID_SHA256_CERT_FINGERPRINTS=
